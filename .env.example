# Burgundy Residences — environment
#
# Leave BOTH unset to run in local demo mode: data lives in the browser only.
# Set BOTH to switch the whole app onto a real Supabase backend, where the RLS
# policies in supabase/migrations/0001_init.sql become the enforced rules.
#
# Setup:
#   1. Create a Supabase project
#   2. Run supabase/migrations/0001_init.sql against it
#   3. Fill in the two values below (the anon key is safe to expose — it is
#      only usable within the RLS policies)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
